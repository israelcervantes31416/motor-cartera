#!/bin/sh
# Lo lee (source) el entrypoint de la imagen de nginx antes de renderizar las plantillas: exporta
# como variables de entorno los secretos montados que la configuracion necesita, para que no viajen
# en el entorno del contenedor (ni en `docker inspect`). Solo el perfil de produccion los tiene.
if [ -r /run/secrets/gateway_secretos ]; then
    # El edge se presenta ante la API con el primero: el vigente. Los demas, si hay, son los que la
    # API todavia acepta durante una rotacion.
    MC_GATEWAY_SECRET="$(head -n 1 /run/secrets/gateway_secretos | tr -d '\r\n')"
    export MC_GATEWAY_SECRET
fi
