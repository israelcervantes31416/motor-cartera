# Copia este archivo a .env y ajusta si hace falta. Sirve para correr sin Docker; dentro de
# docker compose las variables ya vienen definidas en docker-compose.yml.

# El entorno, declarado: development (una maquina de desarrollo, como este archivo), test (las
# pruebas) o production. Sin esta variable la configuracion se comporta como produccion y falla
# cerrada: no arranca sin OpenID Connect, sin el secreto del gateway ni con la clave de desarrollo.
MC_APP_ENV=development
MC_DATABASE_URL=postgresql+psycopg://motor:motor@localhost:5434/cartera_dev
MC_SEMILLA=31416

# El almacen de artefactos fuente: cada archivo recibido, guardado por su SHA-256, sin borrarse.
# La API y el worker tienen que ver el mismo. Dentro del compose es un volumen propio.
MC_SOURCE_STORE_ROOT=datos/fuentes

# Un despacho y una cartera: metadata del sistema que cada corrida e ingesta registra.
# MC_DESPACHO_ID=DSP_001
# MC_CARTERA_ID=CARTERA_PRINCIPAL

# La clave universal de DESARROLLO: vale para todo. En produccion no existe (definirla impide
# arrancar): cada servicio usa su clave con sus permisos (MC_API_KEYS_FILE).
MC_API_KEY=clave-local-de-desarrollo

# Fraccion maxima de registros rechazados con la que una corrida todavia publica (0 a <1).
MC_TOLERANCIA_RECHAZO=0.05

# Lo mismo para una ingesta de pagos (pagos/v1). Por omision 0: un movimiento invalido rechaza el
# archivo entero, porque un archivo de dinero aceptado a medias subestima la recuperacion.
# MC_TOLERANCIA_RECHAZO_PAGOS=0

# De cuantas filas se lee y se juzga cada lote de una fuente oficial (cartera/v2, pagos/v1). Cambia
# la memoria que se usa, nunca el resultado.
# MC_FILAS_POR_LOTE=50000

# Tope del archivo que aceptan POST /corridas y POST /pagos, en MiB. Se copia al almacen por
# bloques, sin cargarlo en memoria: el tope cuida el disco.
MC_TAMANO_MAXIMO_MB=512

# Parametros operativos del worker (motor-cartera worker): cambian cuando y cuantas veces se
# intenta un trabajo, nunca lo que decide un motor. Comentados, valen lo que dice cada uno.
# Cuanto espera antes de volver a buscar trabajo cuando la cola esta vacia, en segundos.
# MC_WORKER_POLL_SEGUNDOS=0.5
# Cuanto tiempo es suyo un trabajo sin latir; al vencer, otro worker lo puede tomar.
# MC_WORKER_LEASE_SEGUNDOS=60
# Cada cuanto late para renovar el lease. Tiene que ser menor que el lease.
# MC_WORKER_HEARTBEAT_SEGUNDOS=20
# Cuantas veces se puede tomar un trabajo antes de darlo por FALLIDO.
# MC_WORKER_MAX_INTENTOS=5
# Espera tras el primer error de un trabajo, en segundos; se duplica en cada intento: 1, 2, 4...
# MC_WORKER_BACKOFF_SEGUNDOS=1

# Base de las pruebas: se vacia en cada prueba, asi que debe llamarse *_test.
# MC_DATABASE_URL_PRUEBAS=postgresql+psycopg://motor:motor@localhost:5434/cartera_test

# El Marco Geoestadistico Integrado 2025 del INEGI, si se descargo (ver docs/geografia.md): con el,
# una prueba importa la referencia oficial y el benchmark de la geografia la usa. Sin el, esa prueba
# se salta. El CI no lo descarga.
# MC_REFERENCIA_INEGI=datos/referencias/inegi_mg_2025/mg_2025_integrado.zip

# El proveedor de ruteo de ruteo/v2: un OSRM autoalojado que sirve una red vial preparada (ver
# docs/red_vial.md). Nunca el servidor publico de OSRM ni otro servicio externo: las coordenadas
# de las cuentas no salen de la red propia. Sin MC_OSRM_URL este proceso no rutea: la API sigue
# aceptando ejecuciones y un worker que si lo tenga las resuelve. Los demas, comentados, valen lo
# que dice cada uno, y cambian cuanto se espera y cuanto se reintenta, nunca una ruta.
# MC_OSRM_URL=http://localhost:5000
# MC_OSRM_TIMEOUT_CONEXION_SEGUNDOS=3
# MC_OSRM_TIMEOUT_LECTURA_SEGUNDOS=30
# Reintentos de una peticion ante un fallo transitorio (sin contar la primera), con espera
# exponencial desde MC_OSRM_BACKOFF_SEGUNDOS.
# MC_OSRM_REINTENTOS=2
# MC_OSRM_BACKOFF_SEGUNDOS=0.5
# Cuantos puntos van en cada peticion nearest (el snap). osrm-routed se levanta con
# --max-nearest-locations igual o mayor.
# MC_OSRM_LOTE_NEAREST=100
# Cuantas matrices se piden a la vez mientras se planea la ruta de otro gestor.
# MC_OSRM_CONCURRENCIA=4
# Cada cuanto el worker vuelve a preguntar si el proveedor responde antes de tomar un RUTEO_V2.
# MC_OSRM_SALUD_SEGUNDOS=10

# Las pruebas de integracion con OSRM de verdad (tests/test_ruteo_v2_osrm.py): un osrm-routed que
# sirve la red sintetica y el directorio donde se preparo. Sin ellas, esas pruebas se saltan.
# MC_OSRM_URL_PRUEBAS=http://localhost:5005
# MC_RED_VIAL_PRUEBAS=datos/red_vial/<huella>

# --- Produccion (docs/production.md) ---------------------------------------------------------------
# Solo los nombres, nunca un valor: cada secreto va en un archivo montado y se lee por su *_FILE. En
# el compose de produccion ya vienen definidos; aqui, de referencia.
# MC_APP_ENV=production
# MC_DATABASE_URL_FILE=/run/secrets/dsn_api
# MC_API_KEYS_FILE=/run/secrets/api_claves
# MC_GATEWAY_SECRETS_FILE=/run/secrets/gateway_secretos
# MC_AUDITORIA_CLAVE_FILE=/run/secrets/auditoria_clave
# MC_OIDC_ISSUER=https://idp.example.com/realms/motor-cartera
# MC_OIDC_AUDIENCE=motor-cartera-api
# MC_OIDC_JWKS_URL=https://idp.example.com/realms/motor-cartera/protocol/openid-connect/certs
# MC_OIDC_GRUPOS=mc-lectores=VIEWER;mc-auditores=AUDITOR;mc-operadores=OPERATOR;mc-administradores=ADMIN
# MC_LOG_FORMATO=json
# MC_METRICAS_PUERTO=9464
# MC_OTEL_ENDPOINT=http://otel-collector:4318
