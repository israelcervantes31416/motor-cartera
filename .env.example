# Copia este archivo a .env y ajusta si hace falta. Sirve para correr sin Docker; dentro de
# docker compose las variables ya vienen definidas en docker-compose.yml.
MC_DATABASE_URL=postgresql+psycopg://motor:motor@localhost:5434/cartera_dev
MC_SEMILLA=31416

# La API no arranca sin clave. Cambiala: esta es solo para desarrollo local.
MC_API_KEY=clave-local-de-desarrollo

# Fraccion maxima de registros rechazados con la que una corrida todavia publica (0 a <1).
MC_TOLERANCIA_RECHAZO=0.05

# Tope del archivo que acepta POST /corridas, en MiB.
MC_TAMANO_MAXIMO_MB=50

# Parametros operativos del worker (motor-cartera worker): cambian cuando y cuantas veces se
# intenta un trabajo, nunca lo que decide un motor. Comentados, valen lo que dice cada uno.
# Cuanto espera antes de volver a buscar trabajo cuando la cola esta vacia, en segundos.
# MC_WORKER_POLL_SEGUNDOS=0.5
# Cuanto tiempo es suyo un trabajo sin latir; al vencer, otro worker lo puede tomar.
# MC_WORKER_LEASE_SEGUNDOS=60
# Cada cuanto late para renovar el lease. Tiene que ser menor que el lease.
# MC_WORKER_HEARTBEAT_SEGUNDOS=20
# Cuantas veces se puede tomar un trabajo antes de darlo por FALLIDO.
# MC_WORKER_MAX_INTENTOS=5
# Espera tras el primer error de un trabajo, en segundos; se duplica en cada intento: 1, 2, 4...
# MC_WORKER_BACKOFF_SEGUNDOS=1

# Base de las pruebas: se vacia en cada prueba, asi que debe llamarse *_test.
# MC_DATABASE_URL_PRUEBAS=postgresql+psycopg://motor:motor@localhost:5434/cartera_test
