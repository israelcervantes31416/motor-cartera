# Normaliza finales de linea en el repositorio: siempre LF.
# Sin esto, trabajar entre Windows y WSL produce diffs de miles de lineas
# que no cambian nada. Es el problema clasico de CRLF/LF.
* text=auto eol=lf

*.png binary
*.jpg binary
*.xlsx binary
*.zip binary

# La plantilla que genera Alembic para cada migracion: no es codigo del proyecto, pero GitHub
# la contaba como Mako en las estadisticas de lenguajes.
migraciones/script.py.mako linguist-generated
